name: Release

# Bootstrap the repo secrets this workflow needs once it is on GitHub:
#     clihatch secrets {{owner}}/{{name}}        # use --dry-run to preview
#
# Each target publishes in its own job, so one target's failure (for example a
# registry rate limit) does not block the others. Re-run only the failed target
# with: gh run rerun <run-id> --failed

on:
  push:
    tags:
      - 'v[0-9]*.[0-9]*.[0-9]*'
  workflow_dispatch:
    inputs:
      version:
        description: 'Version to rehearse (defaults to Cargo.toml)'
        required: false
        type: string
      dry_run:
        description: 'Dry run mode (skip actual publishing)'
        required: false
        default: true
        type: boolean
      skip_crates_io:
        description: 'Skip publishing to crates.io (if already published)'
        required: false
        default: false
        type: boolean
{{#pypi}}
      skip_pypi:
        description: 'Skip publishing to PyPI (if already published)'
        required: false
        default: false
        type: boolean
{{/pypi}}

permissions:
  contents: read

env:
  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
  # Avoid the intermittent "HTTP2 framing layer" curl errors when cargo fetches
  # from crates.io on GitHub-hosted runners.
  CARGO_HTTP_MULTIPLEXING: "false"

jobs:
  metadata:
    name: Validate release metadata
    runs-on: ubuntu-latest
    outputs:
      version: ${{ steps.release.outputs.version }}
      tag: ${{ steps.release.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Resolve and validate release metadata
        id: release
        shell: bash
        env:
          REQUESTED_VERSION: ${{ inputs.version }}
          DRY_RUN: ${{ inputs.dry_run }}
        run: |
          manifest_version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -1)
          version="${REQUESTED_VERSION#v}"
          version="${version:-$manifest_version}"
          if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([+-][0-9A-Za-z.-]+)?$ ]]; then
            echo "Invalid release version: $version" >&2
            exit 1
          fi
          if [[ "$manifest_version" != "$version" ]]; then
            echo "Cargo.toml is $manifest_version but requested version is $version" >&2
            exit 1
          fi
          if [[ -f pyproject.toml ]]; then
            python_version=$(sed -n 's/^version = "\([^"]*\)"/\1/p' pyproject.toml | head -1)
            if [[ -n "$python_version" && "$python_version" != "$version" ]]; then
              echo "pyproject.toml is $python_version but Cargo.toml is $version" >&2
              exit 1
            fi
          fi
          tag="v${version}"
          if [[ "${GITHUB_EVENT_NAME}" == "push" && "${GITHUB_REF_NAME}" != "$tag" ]]; then
            echo "Tag ${GITHUB_REF_NAME} does not match package version $tag" >&2
            exit 1
          fi
          if [[ "${GITHUB_EVENT_NAME}" == "workflow_dispatch" && "$DRY_RUN" != "true" ]]; then
            if [[ "${GITHUB_REF_TYPE}" != "tag" || "${GITHUB_REF_NAME}" != "$tag" ]]; then
              echo "A non-dry manual release must run from the existing $tag tag" >&2
              exit 1
            fi
          fi
          echo "version=$version" >> "$GITHUB_OUTPUT"
          echo "tag=$tag" >> "$GITHUB_OUTPUT"

  test:
    name: Run tests
    needs: metadata
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          install: false
      - name: Install test tools
        run: |
          mise install rust cargo-binstall
          mise install cargo:cargo-nextest
      - name: Verify Cargo.lock is up to date
        run: cargo check --locked
      - name: Run tests
        run: make test

  build:
    name: Build ${{ matrix.target }}
    needs: [metadata, test]
    timeout-minutes: 30
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: ubuntu-22.04
            target: x86_64-unknown-linux-gnu
          - os: ubuntu-22.04-arm
            target: aarch64-unknown-linux-gnu
          - os: macos-14
            target: aarch64-apple-darwin
          # Cross-compiled on Apple Silicon (Intel mac runners are scarce).
          - os: macos-14
            target: x86_64-apple-darwin
            cross: true
    runs-on: ${{ matrix.os }}
    env:
      RELEASE_TAG: ${{ needs.metadata.outputs.tag }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          install: false
      - name: Install Rust
        run: mise install rust
      - name: Install Rust target
        run: rustup target add ${{ matrix.target }}
{{#pypi}}

      # Portable wheels: maturin-action builds linux wheels inside a manylinux
      # container and macOS wheels natively.
      - name: Build wheel
        uses: PyO3/maturin-action@e83996d129638aa358a18fbd1dfb82f0b0fb5d3b # v1.51.0
        with:
          target: ${{ matrix.target }}
          args: --release --out dist
          manylinux: auto
{{/pypi}}

      - name: Build binary
        run: cargo build --release --target ${{ matrix.target }}

      - name: Verify binary
        # Skip for cross-compiled targets the runner cannot execute.
        if: ${{ !matrix.cross }}
        run: ./target/${{ matrix.target }}/release/{{name}} --version

      - name: Create release archive
        shell: bash
        run: |
          VERSION="$RELEASE_TAG"
          ARCHIVE_NAME="{{name}}-${VERSION}-${{ matrix.target }}"
          mkdir -p release-package
          cp "target/${{ matrix.target }}/release/{{name}}" release-package/{{name}}
          tar -czf "${ARCHIVE_NAME}.tar.gz" -C release-package {{name}}
          if [[ "${{ runner.os }}" == "macOS" ]]; then
            shasum -a 256 "${ARCHIVE_NAME}.tar.gz" > "${ARCHIVE_NAME}.tar.gz.sha256"
          else
            sha256sum "${ARCHIVE_NAME}.tar.gz" > "${ARCHIVE_NAME}.tar.gz.sha256"
          fi
          rm -rf release-package
{{#pypi}}

      - name: Upload wheel
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: wheel-${{ matrix.target }}
          path: dist/*.whl
{{/pypi}}

      - name: Upload release archives
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: release-${{ matrix.target }}
          path: |
            {{name}}-*-${{ matrix.target }}.tar.gz*
{{#pypi}}

  sdist:
    name: Build source distribution
    needs: [metadata, test]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
      - name: Build sdist
        run: uvx --from maturin==1.14.1 maturin sdist --out dist
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: sdist
          path: dist/*.tar.gz
{{/pypi}}

  # crates.io publishes independently: a failure here does not block the other
  # targets, and `gh run rerun --failed` retries only this job.
  publish-crates:
    name: Publish to crates.io
    needs: [metadata, build]
    runs-on: ubuntu-latest
    permissions:
      contents: read
      id-token: write

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: jdx/mise-action@3c2e0cf82a5b2e5249f0d3635a4d83d0ae861518 # v4.2.5
        with:
          install: false
      - name: Install Rust
        run: mise install rust

      - name: Authenticate to crates.io via Trusted Publishing
        id: crates_io_auth
        if: ${{ inputs.dry_run != true && inputs.skip_crates_io != true }}
        # v1.0.5
        uses: rust-lang/crates-io-auth-action@c6f97d42243bad5fab37ca0427f495c86d5b1a18

      - name: Publish to crates.io
        if: ${{ inputs.dry_run != true && inputs.skip_crates_io != true }}
        env:
          CARGO_REGISTRY_TOKEN: ${{ steps.crates_io_auth.outputs.token }}
        run: cargo publish --locked

      - name: Test crates.io publish (dry run)
        if: ${{ inputs.dry_run == true && inputs.skip_crates_io != true }}
        run: cargo publish --dry-run --locked

      - name: Skip crates.io publishing
        if: ${{ inputs.skip_crates_io == true }}
        run: echo "Skipping crates.io publishing as requested"
{{#pypi}}

  # PyPI publishes independently (isolating new-project rate limits, etc.).
  publish-pypi:
    name: Publish to PyPI
    needs: [metadata, build, sdist]
    runs-on: ubuntu-latest
    steps:
      - uses: astral-sh/setup-uv@20cfd1bf945f4377ade1205e4dbc17946fc9a30d # v10.0.1
      - name: Download wheels and sdist
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          path: artifacts
      - name: Publish to PyPI
        if: ${{ inputs.dry_run != true && inputs.skip_pypi != true }}
        run: uv publish artifacts/wheel-*/*.whl artifacts/sdist/*.tar.gz
        env:
          UV_PUBLISH_TOKEN: ${{ secrets.PYPI_API_TOKEN }}
      - name: Test PyPI artifacts (dry run)
        if: ${{ inputs.dry_run == true && inputs.skip_pypi != true }}
        run: uvx --from twine==6.2.0 twine check --strict artifacts/wheel-*/*.whl artifacts/sdist/*.tar.gz
      - name: Skip PyPI publishing
        if: ${{ inputs.skip_pypi == true }}
        run: echo "Skipping PyPI publishing as requested"
{{/pypi}}

  github-release:
    name: Create GitHub release
    needs: [metadata, build]
    if: ${{ inputs.dry_run != true }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
      attestations: write
    steps:
      - name: Download release archives
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          pattern: release-*
          path: artifacts
      - name: Create Release
        uses: softprops/action-gh-release@3d0d9888cb7fd7b750713d6e236d1fcb99157228 # v3.0.2
        with:
          generate_release_notes: true
          files: |
            artifacts/release-*/{{name}}-*.tar.gz
            artifacts/release-*/{{name}}-*.tar.gz.sha256
      - name: Attest published release archives
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4.2.2
        with:
          subject-path: artifacts/release-*/{{name}}-*.tar.gz

  update-homebrew:
    name: Update Homebrew tap
    needs: [metadata, github-release]
    if: ${{ inputs.dry_run != true }}
    runs-on: ubuntu-latest
    steps:
      - name: Download release archives
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          pattern: release-*
          path: /tmp/artifacts

      - name: Compute SHA256 hashes
        id: hashes
        run: |
          for target in x86_64-apple-darwin aarch64-apple-darwin x86_64-unknown-linux-gnu aarch64-unknown-linux-gnu; do
            sha=$(cat /tmp/artifacts/release-${target}/{{name}}-${{ needs.metadata.outputs.tag }}-${target}.tar.gz.sha256 | awk '{print $1}')
            key=$(echo "${target}" | tr '-' '_')
            echo "${key}=${sha}" >> "$GITHUB_OUTPUT"
          done

      - name: Update Homebrew formula
        env:
          HOMEBREW_TAP_DEPLOY_KEY: ${{ secrets.HOMEBREW_TAP_DEPLOY_KEY }}
        run: |
          if [ -z "$HOMEBREW_TAP_DEPLOY_KEY" ]; then
            echo "HOMEBREW_TAP_DEPLOY_KEY is not configured; skipping Homebrew update."
            exit 0
          fi
          VERSION="${{ needs.metadata.outputs.tag }}"
          VERSION_NUM="${VERSION#v}"

          cat > /tmp/{{name}}.rb << 'FORMULA'
          class {{name_pascal}} < Formula
            desc "{{description}}"
            homepage "https://github.com/{{owner}}/{{name}}"
            version "VERSION_NUM"
            license "MIT"

            on_macos do
              if Hardware::CPU.arm?
                url "https://github.com/{{owner}}/{{name}}/releases/download/VERSION/{{name}}-VERSION-aarch64-apple-darwin.tar.gz"
                sha256 "SHA_AARCH64_APPLE_DARWIN"
              else
                url "https://github.com/{{owner}}/{{name}}/releases/download/VERSION/{{name}}-VERSION-x86_64-apple-darwin.tar.gz"
                sha256 "SHA_X86_64_APPLE_DARWIN"
              end
            end

            on_linux do
              if Hardware::CPU.arm?
                url "https://github.com/{{owner}}/{{name}}/releases/download/VERSION/{{name}}-VERSION-aarch64-unknown-linux-gnu.tar.gz"
                sha256 "SHA_AARCH64_UNKNOWN_LINUX_GNU"
              else
                url "https://github.com/{{owner}}/{{name}}/releases/download/VERSION/{{name}}-VERSION-x86_64-unknown-linux-gnu.tar.gz"
                sha256 "SHA_X86_64_UNKNOWN_LINUX_GNU"
              end
            end

            def install
              bin.install "{{name}}"
            end

            test do
              system "#{bin}/{{name}}", "--version"
            end
          end
          FORMULA

          sed -i "s/VERSION_NUM/${VERSION_NUM}/g" /tmp/{{name}}.rb
          sed -i "s/VERSION/${VERSION}/g" /tmp/{{name}}.rb
          sed -i "s/SHA_AARCH64_APPLE_DARWIN/${{ steps.hashes.outputs.aarch64_apple_darwin }}/g" /tmp/{{name}}.rb
          sed -i "s/SHA_X86_64_APPLE_DARWIN/${{ steps.hashes.outputs.x86_64_apple_darwin }}/g" /tmp/{{name}}.rb
          sed -i "s/SHA_AARCH64_UNKNOWN_LINUX_GNU/${{ steps.hashes.outputs.aarch64_unknown_linux_gnu }}/g" /tmp/{{name}}.rb
          sed -i "s/SHA_X86_64_UNKNOWN_LINUX_GNU/${{ steps.hashes.outputs.x86_64_unknown_linux_gnu }}/g" /tmp/{{name}}.rb

          mkdir -p ~/.ssh
          echo "$HOMEBREW_TAP_DEPLOY_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          ssh-keyscan -t ed25519 github.com >> ~/.ssh/known_hosts 2>/dev/null

          git clone git@github.com:{{owner}}/homebrew-tap.git /tmp/tap
          mkdir -p /tmp/tap/Formula
          cp /tmp/{{name}}.rb /tmp/tap/Formula/{{name}}.rb
          cd /tmp/tap
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add Formula/{{name}}.rb
          git diff --cached --quiet || git commit -m "Update {{name}} to ${VERSION}"
          git push
